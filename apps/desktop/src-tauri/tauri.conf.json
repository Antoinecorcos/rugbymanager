{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ovalie Manager",
  "version": "0.1.0",
  "identifier": "fr.ovaliemanager.jeu",
  "build": {
    "frontendDist": "../../game/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @ovalie/game dev",
    "beforeBuildCommand": "pnpm --filter @ovalie/game build"
  },
  "app": {
    "windows": [
      {
        "title": "Ovalie Manager",
        "width": 1600,
        "height": 960,
        "minWidth": 1280,
        "minHeight": 760,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SimulationGame",
    "shortDescription": "Jeu de management de rugby",
    "longDescription": "Ovalie Manager : Top 14, Pro D2, Nationale et coupes d'Europe, avec les vrais effectifs et le vrai calendrier. Jeu non commercial.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
